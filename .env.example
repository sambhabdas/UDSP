# Deployment configuration for the Ultimate DSP console.
#
# Everything here is NEXT_PUBLIC_, which means it is compiled into the client
# bundle in plain text and is readable by anyone who loads the page. No secret
# belongs in this file. There is no backend yet, so nothing here is a credential.

# Shown in the rail monogram and the header wordmark.
NEXT_PUBLIC_BRAND_NAME=PacTrack

# The signed-in operator, until there is an auth provider to ask.
NEXT_PUBLIC_USER_NAME=Kai Sato

# The station this build is dispatching for.
NEXT_PUBLIC_STATION_CODE=DBO1
NEXT_PUBLIC_STATION_NAME=Joliet, IL
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Cedar Ridge Logistics LLC

# The station's outbound SMS line, shown against every message it sends.
NEXT_PUBLIC_STATION_PHONE=+1 (312) 555-6921

# How every figure on every page is formatted. Fixed for the whole deployment
# rather than taken from the visitor's browser: the server renders the first
# paint, so a per-visitor locale would make the markup disagree with itself at
# hydration — and an operator reading "1.204,50" where a colleague reads
# "1,204.50" is a reconciliation bug, not a preference.
NEXT_PUBLIC_LOCALE=en-US
NEXT_PUBLIC_CURRENCY=USD

# Extra hosts allowed to load dev resources, comma separated. next.config.ts
# already covers the usual LAN ranges; add anything else here (a machine name,
# a tunnel host) rather than editing the config.
DEV_ORIGINS=
